# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-here

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database Configuration (PostgreSQL)
USE_POSTGRESQL=False
DB_NAME=seat_booking
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@seatbooking.app

# Safaricom Daraja API (M-Pesa)
DARAJA_CONSUMER_KEY=your_consumer_key
DARAJA_CONSUMER_SECRET=your_consumer_secret
DARAJA_BUSINESS_SHORTCODE=your_shortcode
DARAJA_PASSKEY=your_passkey
DARAJA_CALLBACK_URL=https://yourdomain.com/api/v1/payments/mpesa/callback/
DARAJA_TIMEOUT_URL=https://yourdomain.com/api/v1/payments/mpesa/timeout/

# Redis (for caching and Celery)
REDIS_URL=redis://localhost:6379/0

# Seat Booking Settings
SEAT_HOLD_DURATION_MINUTES=10
MAX_CONCURRENT_BOOKING_ATTEMPTS=100

# QR Code Settings
QR_CODE_PREFIX=SB
QR_CODE_VERSION=10  # Size of QR code

# Application Settings
APP_NAME=Seat Booking System
APP_VERSION=1.0.0
